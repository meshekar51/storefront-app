# Pinned versions of everything installed into the cluster. Bump here, re-run 02-install-addons.sh.
AWS_LBC_CHART_VERSION=3.5.0          # aws-load-balancer-controller  (https://aws.github.io/eks-charts)
ENVOY_GATEWAY_VERSION=v1.9.2         # envoyproxy/gateway-helm       (oci://docker.io/envoyproxy)
EXTERNAL_SECRETS_CHART_VERSION=2.11.0 # external-secrets             (https://charts.external-secrets.io)
METRICS_SERVER_CHART_VERSION=3.14.0  # metrics-server                (https://kubernetes-sigs.github.io/metrics-server)
